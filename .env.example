# Discord channel webhook for founding invite form submissions.
# Create in Discord: Channel Settings → Integrations → Webhooks → New Webhook
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/REDACTED/REDACTED

# HMAC secret for invite form timing tokens (long random string).
# Generate with: openssl rand -hex 32
FORM_SIGNING_SECRET=replace-with-a-long-random-secret

# Cloudflare Turnstile (https://dash.cloudflare.com → Turnstile)
# Site key is public (also in site/content.js + index.html). Secret stays server-side only.
TURNSTILE_SITE_KEY=0x4AAAAAAFjWYyBYlaY-3qPD
TURNSTILE_SECRET_KEY=replace-with-turnstile-secret-key
