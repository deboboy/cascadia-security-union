# Discord channel webhook for founding invite form submissions.
# Create in Discord: Channel Settings → Integrations → Webhooks → New Webhook
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/REDACTED/REDACTED

# HMAC secret for invite form timing + challenge tokens (long random string).
# Generate with: openssl rand -hex 32
FORM_SIGNING_SECRET=replace-with-a-long-random-secret
